# =============================================================================
# Jumaah Cloud — environment configuration (copy to .env next to docker-compose.yml)
# =============================================================================
IMAGE_TAG=1.2.0
REGISTRY=malkurbi5

# ---- Addresses ---------------------------------------------------------------
# The platform address (super admin) and the base domain of the mosques (<slug>.jumaah.net).
SITE_ADDRESS=cloud.jumaah.net
PUBLIC_BASE_URL=https://cloud.jumaah.net
TENANT_BASE_DOMAIN=jumaah.net
# Wildcard certificate through the DNS challenge: a Cloudflare token with Zone / DNS / Edit on the base domain.
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=
# Browser origins of the marketing site (its sign-up and sponsor forms call this API).
CORS_ORIGINS=https://www.jumaah.net,https://jumaah.net
# The marketing site, linked from emails and the admin.
SITE_URL=https://www.jumaah.net

# ---- Database / Redis --------------------------------------------------------
POSTGRES_USER=jumaah
POSTGRES_PASSWORD=
POSTGRES_DB=jumaah

# ---- Security (generate with: openssl rand -hex 32) ----------------------------
JWT_SECRET=
ENCRYPTION_KEY=
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=600

# ---- Seed (first start with SEED_ON_START=1) -----------------------------------
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
# The demo mosque's accounts (leave empty to keep the built-in demo password; suspend the demo mosque in production)
SEED_DEMO_PASSWORD=

# ---- Platform translation providers (bootstrap; manageable in Admin → Providers) ----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=

# ---- Marketing site (--profile site) ----------------------------------------------
# Contact form mail through Resend, delivered to SITE_TO_EMAIL; Turnstile protects the public forms.
RESEND_API_KEY=
SITE_TO_EMAIL=
TURNSTILE_SECRET_KEY=

# ---- Billing, payment and email defaults ---------------------------------------
# Everything below is editable in the portal (Admin → Platform → Platform settings); these are only defaults.
BILLING_SELLER_NAME=Jumaah Cloud
BILLING_SELLER_ADDRESS=
BILLING_VAT_RATE=0
BILLING_VAT_NUMBER=
BILLING_BANK=
BILLING_IBAN=
PAYMENT_PROVIDER=manual
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Jumaah
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=
MAIL_NOTIFY=

# ---- Scaling -------------------------------------------------------------------
API_REPLICAS=1
BACKUP_KEEP=50
