// Jumaah Cloud additions to the core schema. scripts/compose-schema.mjs merges this file into the core schema
// (packages/db/prisma/schema.prisma of the Community repository) to produce schema.prisma next to it.
//
//   // @extend <Model>   fields, relations and indexes appended to a core model
//   enum / model         added as they are

enum SubscriptionPlan {
  FREE
  BASIC
  STANDARD
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  PAST_DUE
  SUSPENDED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

enum InvoiceKind {
  SUBSCRIPTION
  SPONSORSHIP
  /// Written by the super admin: bulk contracts, adjustments, anything with its own wording and amount.
  CUSTOM
}

enum SponsorshipStatus {
  PENDING
  PAID
  APPLIED
}

// @extend Tenant
  plan                  SubscriptionPlan   @default(FREE)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  subscriptionEndsAt    DateTime?
  /// Shared secret used by this tenant's edge server to authenticate against the cloud.
  syncKeyHash           String?
  /// Hosted edition (Pro): the mosque's own address, e.g. khutbah.alnoor.org.sa, and when its DNS was last verified.
  customDomain           String?   @unique
  customDomainVerifiedAt DateTime?
  /// Hosted edition: the organisation account this mosque belongs to (one login managing several mosques).
  organisationId        String?
  /// Billing (hosted edition): the cycle and the details printed on invoices.
  billingCycle          BillingCycle       @default(MONTHLY)
  billingName           String?
  billingVatNumber      String?
  billingAddress        String?
  billingEmail          String?
  /// The mosque asked to stop: no renewal invoice; at the paid-until date the plan falls back to FREE, nothing is deleted.
  cancelAtPeriodEnd     Boolean            @default(false)
  /// When the "your trial ends soon" email went out (sent once per trial).
  trialNoticeSentAt     DateTime?

  organisation    Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  aiUsage         AiUsage[]
  apiKeys         ApiKey[]
  webhooks        Webhook[]
  networkTranslations NetworkTranslation[]
  invoices        Invoice[]

  @@index([organisationId])
// @end

// @extend User
  /// Set for organisation admins: they may manage every mosque of that organisation.
  organisationId String?

  organisation  Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
// @end

// @extend LiveSession
  /// Attendance insight (paid editions): most screens and phones connected at once, and distinct phones seen.
  peakDisplays       Int          @default(0)
  peakPhones         Int          @default(0)
  uniquePhones       Int          @default(0)
// @end

/// Shared translation network (hosted edition): approved translations a mosque chose to share, keyed by the
/// paragraph hash (normalised Arabic) and language. Read by every mosque whose plan includes the network.
model NetworkTranslation {
  id             String        @id @default(cuid())
  hash           String
  lang           String
  text           String
  kind           ParagraphKind @default(TEXT)
  reference      String?
  sourceTenantId String
  uses           Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sourceTenant Tenant @relation(fields: [sourceTenantId], references: [id], onDelete: Cascade)

  @@unique([hash, lang, sourceTenantId])
  @@index([hash, lang])
}

/// API key of a mosque (hosted edition, plans with the API feature). Hashed at rest; read-only or read-write.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String
  keyHash     String    @unique
  readOnly    Boolean   @default(true)
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Webhook endpoint of a mosque: signed JSON deliveries for the chosen events.
model Webhook {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  url             String
  secret          String
  events          String[]
  enabled         Boolean   @default(true)
  lastStatus      Int?
  lastError       String?
  lastDeliveredAt DateTime?
  failures        Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Hosted edition: an organisation (charity, awqaf office, chain of mosques) whose admins manage several mosques
/// from one login. Member mosques carry the ENTERPRISE plan; the AI allowance is pooled across them.
model Organisation {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  maxTenants Int      @default(10)
  /// Billing: organisations are invoiced as one customer (yearly by default).
  billingCycle     BillingCycle @default(YEARLY)
  billingName      String?
  billingVatNumber String?
  billingAddress   String?
  billingEmail     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenants  Tenant[]
  admins   User[]
  invoices Invoice[]
}

/// An invoice (hosted edition): a subscription renewal for a mosque or an organisation, or a sponsorship. Amounts are
/// halalas. The access token makes the public invoice link (/display/invoice/<number>?t=…) unguessable.
model Invoice {
  id              String        @id @default(cuid())
  number          String        @unique
  kind            InvoiceKind
  status          InvoiceStatus @default(OPEN)
  tenantId        String?
  organisationId  String?
  sponsorshipId   String?       @unique
  plan            SubscriptionPlan?
  cycle           BillingCycle?
  periodStart     DateTime?
  periodEnd       DateTime?
  currency        String        @default("SAR")
  subtotal        Int
  vatRate         Float         @default(0)
  vat             Int
  total           Int
  lines           Json
  billTo          Json
  accessToken     String        @unique
  issuedAt        DateTime      @default(now())
  dueAt           DateTime
  paidAt          DateTime?
  paymentProvider String?
  paymentRef      String?
  paymentUrl      String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  sponsorship  Sponsorship?  @relation(fields: [sponsorshipId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([status, dueAt])
}

/// Sponsor a mosque: a donor pays a year of Standard for N mosques; each seat is applied to a mosque by the platform.
model Sponsorship {
  id           String            @id @default(cuid())
  sponsorName  String
  sponsorEmail String
  sponsorPhone String?
  mosqueName   String?
  message      String?
  mosques      Int               @default(1)
  lang         String            @default("ar")
  status       SponsorshipStatus @default(PENDING)
  /// [{ tenantId, tenantName, at }] one entry per applied seat
  applied      Json              @default("[]")
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  invoice Invoice?
}

/// Platform-AI metering for the hosted edition: one row per job or relay call and language.
/// Only translations produced by platform-owned providers are recorded; a mosque's own keys are never counted.
model AiUsage {
  id           String       @id @default(cuid())
  tenantId     String
  /// Calendar month in UTC, e.g. "2026-09"
  month        String
  khutbahId    String?
  lang         String
  /// JOB (translation job on this server) or RELAY (edge server relaying through the cloud)
  source       String
  providerType ProviderType
  paragraphs   Int
  characters   Int
  createdAt    DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, month])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
