{
  "name": "@jumaah/db",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./seed": {
      "types": "./dist/seed.d.ts",
      "import": "./dist/seed.js"
    }
  },
  "prisma": {
    "seed": "node --import tsx src/seed-run.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "reset": "prisma migrate reset --force",
    "seed": "node --import tsx src/seed-run.ts",
    "studio": "prisma studio"
  },
  "dependencies": {
    "@jumaah/core": "workspace:*",
    "@prisma/client": "^6.1.0",
    "prisma": "^6.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
