{
	admin off
	email {$ACME_EMAIL:admin@jumaah.net}
}

# Hosted edition: the platform address plus one wildcard for every mosque (alnoor.jumaah.net).
# A wildcard certificate needs the DNS challenge, so the web image ships Caddy with the Cloudflare DNS module and
# CLOUDFLARE_API_TOKEN must be a token with "Zone / DNS / Edit" on the base domain.
{$SITE_ADDRESS}, *.{$TENANT_BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	import /etc/caddy/common.caddy
}

# The bare base domain and www redirect to the marketing site.
{$TENANT_BASE_DOMAIN}, www.{$TENANT_BASE_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
	}
	redir https://www.jumaah.net{uri} permanent
}
