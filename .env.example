# =============================================================================
# Jumaah — environment configuration
# Copy to `.env` (root) for local development. Docker compose files read the same keys.
# =============================================================================

# ---- Deployment mode ---------------------------------------------------------
# edge  = mosque-local server (works fully offline, syncs to cloud when online)
# cloud = central platform server (tenant management, library, central keys)
DEPLOYMENT_MODE=edge
IMAGE_TAG=1.0.0
NODE_ENV=development

# ---- Database / Redis --------------------------------------------------------
POSTGRES_USER=jumaah
POSTGRES_PASSWORD=jumaah_dev_password
POSTGRES_DB=jumaah
DATABASE_URL=postgresql://jumaah:jumaah_dev_password@localhost:5432/jumaah?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public URL of the API as seen by browsers (used in QR codes / display URLs)
PUBLIC_BASE_URL=http://localhost:8080
# Hosted edition (cloud only): every mosque gets <slug>.<domain>, e.g. alnoor.jumaah.net. Leave empty on edge servers.
# Needs a wildcard DNS record (*.jumaah.net) and, for the certificate, CLOUDFLARE_API_TOKEN with Zone/DNS/Edit,
# plus CADDY_COMMAND="caddy run --config /etc/caddy/Caddyfile.cloud" and SITE_ADDRESS=cloud.jumaah.net.
TENANT_BASE_DOMAIN=
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=
# Comma separated list of allowed browser origins (dev servers). In Docker everything is same-origin via Caddy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

# ---- Security (CHANGE IN PRODUCTION) ----------------------------------------
# 32+ random chars. Signs access tokens (HS256).
JWT_SECRET=change-me-please-use-a-long-random-string-0123456789
# 32+ random chars. Encrypts provider API keys at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-too-another-long-random-string-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP for auth endpoints / general API
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=300

# ---- Seed --------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@jumaah.app
SEED_SUPER_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!

# ---- Translation providers (optional; can also be configured per tenant in the UI) ----
# Central keys are stored encrypted in the DB by the Super Admin; these env values
# are only used to bootstrap a global provider on first start if set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Edge <-> Cloud sync (edge only) ----------------------------------------
# URL of the cloud API. Leave empty to disable sync entirely.
CLOUD_API_URL=
# Tenant slug this edge server belongs to, and its sync key (issued by Super Admin).
EDGE_TENANT_SLUG=demo
EDGE_SYNC_KEY=demo-sync-key-change-me
# Stable identifier for this edge device (generated if empty)
EDGE_DEVICE_ID=
SYNC_INTERVAL_SECONDS=60

# ---- Backups -----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=20

# ---- Frontends (Vite) --------------------------------------------------------
# Empty = same origin (Docker/Caddy). For local dev point to the API dev server.
VITE_API_URL=http://localhost:4000
# Custom domains (Pro, hosted edition): a mosque points a CNAME at <slug>.<TENANT_BASE_DOMAIN>, verifies it in
# Settings, and Caddy fetches the certificate on the first visit after asking the API (/api/public/domain-check).
# Nothing to configure here; Caddyfile.cloud already carries the on_demand_tls block.

# ---- Billing (Jumaah Cloud only) -------------------------------------------------
# Everything in this block and the email block below is editable in the portal (Admin → Platform → Platform settings);
# the values here are only defaults for a fresh server.
# Invoices are issued automatically before the paid-until date. PAYMENT_PROVIDER=manual means bank transfer (put the
# IBAN below on the invoice; the super admin marks it paid). PAYMENT_PROVIDER=moyasar adds a hosted payment page
# (mada, Apple Pay, cards) and needs the secret key; set the same MOYASAR_WEBHOOK_SECRET in the Moyasar dashboard.
BILLING_SELLER_NAME=Jumaah Cloud
BILLING_SELLER_ADDRESS=
# 0 until VAT-registered, then 0.15 with the 15-digit VAT number (the ZATCA QR appears on invoices once set)
BILLING_VAT_RATE=0
BILLING_VAT_NUMBER=
BILLING_BANK=
BILLING_IBAN=
PAYMENT_PROVIDER=manual
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
# Cloudflare Turnstile secret for the public sponsor form on www.jumaah.net (leave empty to skip verification)
TURNSTILE_SECRET_KEY=

# Marketing site (cloud stack, "site" profile): contact form mail through Resend, delivered to SITE_TO_EMAIL.
RESEND_API_KEY=
SITE_TO_EMAIL=

# ---- Email (defaults; the portal's Platform → Email settings override them) ----------
# Any SMTP provider works (Resend, Postmark, SES, Zoho, your own server). Port 587 with STARTTLS, or 465 with SMTP_SECURE=1.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Jumaah
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=
# Where platform notices go (new sponsorships)
MAIL_NOTIFY=
# The marketing site, linked from emails and the admin
SITE_URL=https://www.jumaah.net
