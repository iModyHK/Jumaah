# =============================================================================
# Jumaah Community Edition — environment configuration
# Copy to `.env` (repository root). docker-compose.yml reads the same keys.
# =============================================================================

IMAGE_TAG=1.0.0
NODE_ENV=development

# ---- Database / Redis --------------------------------------------------------
POSTGRES_USER=jumaah
POSTGRES_PASSWORD=jumaah_dev_password
POSTGRES_DB=jumaah
DATABASE_URL=postgresql://jumaah:jumaah_dev_password@localhost:5432/jumaah?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public URL of the server as seen by browsers (used in QR codes / screen links), e.g. http://192.168.1.10:8080
PUBLIC_BASE_URL=http://localhost:8080
# Caddy: ":80" serves plain HTTP on the LAN; a host name (mosque.example.org) switches on automatic HTTPS.
SITE_ADDRESS=:80
# Comma separated list of allowed browser origins (dev servers). In Docker everything is same-origin via Caddy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

# ---- Security (CHANGE IN PRODUCTION) ----------------------------------------
# 32+ random chars. Signs access tokens (HS256).
JWT_SECRET=change-me-please-use-a-long-random-string-0123456789
# 32+ random chars. Encrypts provider API keys at rest (AES-256-GCM). Never change it after the first start.
ENCRYPTION_KEY=change-me-too-another-long-random-string-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP for auth endpoints / general API
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=300

# ---- Seed (first start with SEED_ON_START=1) -----------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@jumaah.app
SEED_SUPER_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!

# ---- Translation providers (optional; can also be configured in the admin) ------
# Keys are stored encrypted in the database; these values only bootstrap a server-wide provider on first start.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Optional: connect this mosque server to Jumaah Cloud (sync + hosted translation) ----
# Leave CLOUD_API_URL empty to run fully standalone. The slug and the sync key come from your Jumaah Cloud account.
CLOUD_API_URL=
EDGE_TENANT_SLUG=
EDGE_SYNC_KEY=
# Stable identifier for this server (generated if empty)
EDGE_DEVICE_ID=
SYNC_INTERVAL_SECONDS=60

# ---- Backups -----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=20

# ---- Frontends (Vite) --------------------------------------------------------
# Empty = same origin (Docker/Caddy). For local dev point to the API dev server.
VITE_API_URL=http://localhost:4000

# ---- Email (optional: password-reset links) -----------------------------------
# Any SMTP provider works. Port 587 with STARTTLS, or 465 with SMTP_SECURE=1. Without it, reset emails are logged as skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Jumaah
MAIL_FROM_EMAIL=
MAIL_REPLY_TO=
MAIL_NOTIFY=
