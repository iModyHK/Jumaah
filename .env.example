# =============================================================================
# Jumaah — environment configuration
# Copy to `.env` (root) for local development. Docker compose files read the same keys.
# =============================================================================

# ---- Deployment mode ---------------------------------------------------------
# edge  = mosque-local server (works fully offline, syncs to cloud when online)
# cloud = central platform server (tenant management, library, central keys)
DEPLOYMENT_MODE=edge
IMAGE_TAG=1.0.0
NODE_ENV=development

# ---- Database / Redis --------------------------------------------------------
POSTGRES_USER=jumaah
POSTGRES_PASSWORD=jumaah_dev_password
POSTGRES_DB=jumaah
DATABASE_URL=postgresql://jumaah:jumaah_dev_password@localhost:5432/jumaah?schema=public
REDIS_URL=redis://localhost:6379

# ---- API ---------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Public URL of the API as seen by browsers (used in QR codes / display URLs)
PUBLIC_BASE_URL=http://localhost:8080
# Comma separated list of allowed browser origins (dev servers). In Docker everything is same-origin via Caddy.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
LOG_LEVEL=info

# ---- Security (CHANGE IN PRODUCTION) ----------------------------------------
# 32+ random chars. Signs access tokens (HS256).
JWT_SECRET=change-me-please-use-a-long-random-string-0123456789
# 32+ random chars. Encrypts provider API keys at rest (AES-256-GCM).
ENCRYPTION_KEY=change-me-too-another-long-random-string-9876543210
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Requests per minute per IP for auth endpoints / general API
RATE_LIMIT_AUTH=10
RATE_LIMIT_GENERAL=300

# ---- Seed --------------------------------------------------------------------
SEED_SUPER_ADMIN_EMAIL=admin@jumaah.app
SEED_SUPER_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Demo12345!

# ---- Translation providers (optional; can also be configured per tenant in the UI) ----
# Central keys are stored encrypted in the DB by the Super Admin; these env values
# are only used to bootstrap a global provider on first start if set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=http://libretranslate:5000
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Edge <-> Cloud sync (edge only) ----------------------------------------
# URL of the cloud API. Leave empty to disable sync entirely.
CLOUD_API_URL=
# Tenant slug this edge server belongs to, and its sync key (issued by Super Admin).
EDGE_TENANT_SLUG=demo
EDGE_SYNC_KEY=demo-sync-key-change-me
# Stable identifier for this edge device (generated if empty)
EDGE_DEVICE_ID=
SYNC_INTERVAL_SECONDS=60

# ---- Backups -----------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_KEEP=20

# ---- Frontends (Vite) --------------------------------------------------------
# Empty = same origin (Docker/Caddy). For local dev point to the API dev server.
VITE_API_URL=http://localhost:4000
